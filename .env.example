# SmartAgri research prototype: local settings (copy to .env; never commit .env).
# Nothing here is required: without keys the system runs offline on the template generator.

# Answer generator: template (default, deterministic) | llm
ADVICE_GENERATOR=template
# LLM provider for the llm generator, the grounding judge and the VC chat: template | anthropic | openai_compat | claude_cli | bridge
LLM_PROVIDER=template
LLM_MODEL=
ANTHROPIC_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
# Local HTTP bridge to the Claude Code CLI (python -m smartagri.llm.bridge); token shared by bridge and API
LLM_BRIDGE_URL=
LLM_BRIDGE_TOKEN=

# Copernicus Data Space (Sentinel-2 L2A Statistical API); empty = satellite disabled
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Open-Meteo endpoints (defaults are the public services)
OPEN_METEO_BASE=
OPEN_METEO_ARCHIVE_BASE=

# Storage: SQLite file (default ./smartagri.sqlite) or PostgreSQL URL
SMARTAGRI_DB=
DATABASE_URL=
# 1 = never call external services; answers come from the external cache (protocol lock snapshot)
SMARTAGRI_OFFLINE=0
# Retrieval: none (BM25 only) | fastembed
EMBEDDINGS_PROVIDER=none

# Answer language of the research API: en (default) | sr-Latn (local language, Latin script). Evaluation runs and the
# blind rating screen always use the default locale; knowledge passages stay in the corpus language.
SMARTAGRI_LOCALE=en

# Accounts of the web app: off (default; local single-user use, everyone sees every parcel) | optional (public
# deployment: parcels are saved only with an account; without one they are temporary, kept for the browser session).
# See docs/deployment.md.
SMARTAGRI_ACCOUNTS=off
# Accounts on: anonymous (not saved) parcels with their conversations are deleted after this many hours without
# activity (default 24). Also: python -m smartagri.research_api --purge-anonymous
SMARTAGRI_ANON_TTL_HOURS=24
# Public address of the web app (https://app.example.org): links in emails, the Origin check, Secure cookies.
SMARTAGRI_PUBLIC_URL=
# Session lifetime in days (default 30). SMARTAGRI_COOKIE_SECURE=1 forces Secure cookies (set automatically on https).
SMARTAGRI_SESSION_DAYS=30
SMARTAGRI_COOKIE_SECURE=
# Multiplies the per-address rate limits of sign-in and sign-up (default 1), e.g. for many users behind one NAT.
SMARTAGRI_AUTH_RATE_FACTOR=1
# Outgoing email for address confirmation and password reset. Both are on only when SMARTAGRI_SMTP_HOST,
# SMARTAGRI_SMTP_FROM and SMARTAGRI_PUBLIC_URL are set; without them an account works immediately.
SMARTAGRI_SMTP_HOST=
SMARTAGRI_SMTP_PORT=587
# starttls (default) | ssl | none
SMARTAGRI_SMTP_TLS=starttls
SMARTAGRI_SMTP_USER=
SMARTAGRI_SMTP_PASSWORD=
SMARTAGRI_SMTP_FROM=
